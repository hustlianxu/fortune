/* 资讯页样式 */
.page {
  padding-bottom: 40rpx;
}
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.page-title { font-size: 40rpx; font-weight: 700; }
.page-date { font-size: 24rpx; color: var(--text-tertiary); }

/* 分类 Tabs */
.category-tabs {
  margin: 0 20rpx 20rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 16rpx;
}
.tab-scroll {
  white-space: nowrap;
}
.tab-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  background: var(--divider-color);
  color: var(--text-secondary);
}
.tab-item.active {
  background: var(--primary-color);
  color: #fff;
}

/* 资讯卡片 */
.news-card {
  margin: 0 20rpx 16rpx;
  padding: 24rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  box-shadow: var(--shadow-card);
}
.news-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.news-category {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  background: var(--divider-color);
}
.tag-market { background: var(--primary-soft); color: var(--primary-color); }
.tag-industry { background: var(--primary-soft); color: var(--primary-color); }
.tag-company { background: var(--primary-soft); color: var(--primary-color); }
.tag-policy { background: var(--primary-soft); color: var(--primary-color); }
.tag-global { background: var(--primary-soft); color: var(--primary-color); }
.news-source {
  font-size: 22rpx;
  color: var(--text-tertiary);
  flex: 1;
}
.news-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
}
.news-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  display: block;
}
.news-summary {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  line-height: 1.5;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 空状态 */
.empty-state { padding: 100rpx 0; }
.empty-content { text-align: center; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.empty-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  display: block;
  margin: 12rpx 0 32rpx;
}
.btn-secondary {
  display: inline-block;
  padding: 16rpx 40rpx;
  border: 2rpx solid var(--primary-color);
  color: var(--primary-color);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
}
