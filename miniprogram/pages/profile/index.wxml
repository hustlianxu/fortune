<!-- 我的 - 设置页 -->
<view class="page">
  <!-- 用户信息：未登录显示登录入口，已登录显示用户信息 -->
  <view class="card user-card" wx:if="{{userInfo}}">
    <image class="avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
    <view class="user-info">
      <text class="user-name">{{userInfo.nickName}}</text>
      <text class="user-desc">已登录 · 数据按账户隔离</text>
    </view>
  </view>

  <view class="card login-card" wx:else>
    <text class="login-tip">登录后即可同步您的资产数据，数据按微信账户隔离保存</text>
    <view class="login-row">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <text wx:if="{{!tempAvatarUrl}}" class="avatar-text">👤</text>
        <image wx:else class="avatar-img" src="{{tempAvatarUrl}}" mode="aspectFill"></image>
      </button>
      <input class="nickname-input" type="nickname" placeholder="点击输入昵称" value="{{tempNickName}}" bindinput="onNicknameInput" bindblur="onNicknameInput" />
    </view>
    <view class="login-actions">
      <button class="btn-primary" bindtap="onLogin">登录</button>
    </view>
  </view>

  <!-- 账户管理 -->
  <view class="card menu-section">
    <view class="section-title">账户管理</view>
    <view class="menu-item" bindtap="onGoToAccounts">
      <view class="menu-left">
        <text class="menu-icon">🏦</text>
        <text>管理证券/基金账户</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onGoToTransactions">
      <view class="menu-left">
        <text class="menu-icon">📒</text>
        <text>交易流水记录</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onGoToImport">
      <view class="menu-left">
        <text class="menu-icon">📥</text>
        <text>批量导入持仓</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onGoToVoiceImport">
      <view class="menu-left">
        <text class="menu-icon">🎙️</text>
        <text>语音/文字录入交易</text>
      </view>
      <text class="menu-right">
        <text class="menu-desc">AI 解析</text>
        <text class="menu-arrow">›</text>
      </text>
    </view>
    <view class="menu-item" bindtap="onGoToExport">
      <view class="menu-left">
        <text class="menu-icon">📤</text>
        <text>数据导出备份</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onRebuildHoldings">
      <view class="menu-left">
        <text class="menu-icon">🔄</text>
        <text>从交易流水重建持仓</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- AI 模型设置 -->
  <view class="card menu-section">
    <view class="section-title">🤖 AI 模型设置</view>
    <view
      class="menu-item"
      wx:for="{{llmProviders}}"
      wx:key="key"
      bindtap="onConfigureLLM"
      data-provider="{{item.key}}"
    >
      <view class="menu-left">
        <image class="menu-icon-img" src="../../images/providers/provider_{{item.key}}.png" mode="aspectFit"></image>
        <text>{{item.name}}</text>
      </view>
      <view class="menu-right">
        <text class="menu-status {{item.configured ? 'ok' : 'warn'}}">
          {{item.configured ? '✅ 已配置' : '⚠️ 未配置'}}
        </text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onGoToLLMSettings">
      <view class="menu-left">
        <text class="menu-icon">⚙️</text>
        <text>详细设置</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 资讯推送 -->
  <view class="card menu-section">
    <view class="section-title">📰 资讯推送</view>
    <view class="menu-item" bindtap="onGoToNotifySettings">
      <view class="menu-left">
        <text class="menu-icon">🔔</text>
        <text>推送设置</text>
      </view>
      <view class="menu-right">
        <text class="menu-status ok">已开启</text>
        <text class="menu-desc">08:00 / 17:00</text>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="card menu-section">
    <view class="section-title">关于</view>
    <view class="menu-item">
      <view class="menu-left">
        <text class="menu-icon">📖</text>
        <text>版本 0.2.4</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onShowPrivacy">
      <view class="menu-left">
        <text class="menu-icon">🔒</text>
        <text>隐私说明</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-btn" wx:if="{{userInfo}}" bindtap="onLogout">退出登录</view>
</view>
