<!-- 我的 - 设置页 -->
<view class="page">
  <!-- 用户信息 -->
  <view class="card user-card">
    <view class="user-avatar">
      <text class="avatar-text">👤</text>
    </view>
    <view class="user-info">
      <text class="user-name">个人资产管家</text>
      <text class="user-desc">统一管理您的投资资产</text>
    </view>
  </view>

  <!-- 账户管理 -->
  <view class="card menu-section">
    <view class="section-title">账户管理</view>
    <view class="menu-item" bindtap="onGoToAccounts">
      <view class="menu-left">
        <text class="menu-icon">🏦</text>
        <text>管理证券/基金账户</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onGoToTransactions">
      <view class="menu-left">
        <text class="menu-icon">📒</text>
        <text>交易流水记录</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onGoToImport">
      <view class="menu-left">
        <text class="menu-icon">📥</text>
        <text>批量导入持仓</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onGoToExport">
      <view class="menu-left">
        <text class="menu-icon">📤</text>
        <text>数据导出备份</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onRebuildHoldings">
      <view class="menu-left">
        <text class="menu-icon">🔄</text>
        <text>从交易流水重建持仓</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- AI 模型设置 -->
  <view class="card menu-section">
    <view class="section-title">🤖 AI 模型设置</view>
    <view
      class="menu-item"
      wx:for="{{llmProviders}}"
      wx:key="key"
      bindtap="onConfigureLLM"
      data-provider="{{item.key}}"
    >
      <view class="menu-left">
        <text class="menu-icon">{{item.icon}}</text>
        <text>{{item.name}}</text>
      </view>
      <view class="menu-right">
        <text class="menu-status {{item.configured ? 'ok' : 'warn'}}">
          {{item.configured ? '✅ 已配置' : '⚠️ 未配置'}}
        </text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onGoToLLMSettings">
      <view class="menu-left">
        <text class="menu-icon">⚙️</text>
        <text>详细设置</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 资讯推送 -->
  <view class="card menu-section">
    <view class="section-title">📰 资讯推送</view>
    <view class="menu-item" bindtap="onGoToNotifySettings">
      <view class="menu-left">
        <text class="menu-icon">🔔</text>
        <text>推送设置</text>
      </view>
      <view class="menu-right">
        <text class="menu-status ok">已开启</text>
        <text class="menu-desc">08:00 / 17:00</text>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="card menu-section">
    <view class="section-title">关于</view>
    <view class="menu-item">
      <view class="menu-left">
        <text class="menu-icon">📖</text>
        <text>版本 0.2.0</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onShowPrivacy">
      <view class="menu-left">
        <text class="menu-icon">🔒</text>
        <text>隐私说明</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
