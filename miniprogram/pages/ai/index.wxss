/* AI 分析页样式 */
.page {
  padding-bottom: 40rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 700;
}
.page-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

/* 模型选择器 */
.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--border-color);
}
.picker-label { font-size: 28rpx; }
.picker-arrow { font-size: 24rpx; color: var(--text-tertiary); }
.provider-status {
  font-size: 24rpx;
  margin-top: 12rpx;
}
.configured { color: var(--color-down); }
.unconfigured { color: var(--txn-sell); }

/* 持仓概况 */
.overview-grid {
  display: flex;
  flex-wrap: wrap;
}
.overview-item {
  width: 50%;
  padding: 16rpx 0;
}
.overview-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  display: block;
}
.overview-value {
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 4rpx;
  display: block;
}

/* 分析类型 */
.analysis-types {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.analysis-type-item {
  width: calc(50% - 8rpx);
  padding: 24rpx;
  background: var(--bg-input);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.analysis-type-item.selected {
  border-color: var(--primary-color);
  background: var(--bg-card);
}
.type-icon { font-size: 36rpx; display: block; }
.type-name { font-size: 28rpx; font-weight: 600; margin-top: 8rpx; display: block; }
.type-desc { font-size: 22rpx; color: var(--text-tertiary); margin-top: 4rpx; display: block; }

/* 按钮 */
.btn-primary {
  background: var(--primary-color);
  color: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  width: 100%;
  text-align: center;
}
.btn-primary[disabled] {
  opacity: 0.5;
}
.btn-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--txn-sell);
  margin-top: 12rpx;
}

/* 结果 */
.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.result-title { font-size: 32rpx; font-weight: 600; }
.result-date { font-size: 24rpx; color: var(--text-tertiary); }
.result-risk { margin-bottom: 16rpx; }
.risk-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: var(--txn-sell-soft);
  color: var(--txn-sell);
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.result-summary {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
}
.result-findings { margin-bottom: 16rpx; }
.findings-title { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.finding-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
}
.finding-bullet {
  color: var(--txn-sell);
  margin-right: 8rpx;
}
.result-content {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-primary);
}

/* 历史记录 */
.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--divider-color);
}
.history-item:last-child { border-bottom: none; }
.history-left { display: flex; flex-direction: column; }
.history-type { font-size: 28rpx; font-weight: 500; }
.history-model { font-size: 22rpx; color: var(--text-tertiary); }
.history-right { display: flex; align-items: center; }
.history-date { font-size: 24rpx; color: var(--text-tertiary); margin-right: 8rpx; }
.history-arrow { font-size: 32rpx; color: var(--text-tertiary); }

/* 问答 */
.qa-section { margin-top: 0; }
.qa-desc { font-size: 24rpx; color: var(--text-tertiary); margin-bottom: 16rpx; display: block; }
.qa-input-area {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.qa-input {
  flex: 1;
  padding: 20rpx 24rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--text-primary);
  border: 2rpx solid var(--border-color);
}
.qa-send {
  margin-left: 12rpx;
  padding: 16rpx 28rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  border: none;
}
.qa-send[disabled] { opacity: 0.5; }
.quick-q {
  padding: 12rpx 0;
  font-size: 26rpx;
  color: var(--primary-color);
}
.qa-answer {
  margin-top: 16rpx;
  padding: 20rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
}
.qa-bubble {
  font-size: 26rpx;
  line-height: 1.6;
}
