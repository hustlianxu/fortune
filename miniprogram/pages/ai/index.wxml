<!-- AI 持仓分析 -->
<wxs src="../../utils/format.wxs" module="fmt" />
<wxs src="../../utils/constants.wxs" module="c" />
<view class="page">
  <view class="card">
    <text class="page-title">🤖 AI 持仓分析</text>
    <text class="page-desc">基于大模型分析您的持仓健康状况</text>
  </view>

  <!-- 模型选择：多选分析师 + 汇总模型 -->
  <view class="card">
    <view class="section-title">选择分析模型（可多选）</view>
    <text class="section-hint">点击选择 1 个或多个已配置的模型并行分析；选多个时由汇总模型综合各报告</text>
    <scroll-view scroll-x class="provider-chips" wx:if="{{configuredProviders.length > 0}}">
      <view
        wx:for="{{configuredProviders}}"
        wx:key="key"
        class="provider-chip {{analystSelected[item.key] ? 'selected' : ''}}"
        bindtap="onToggleAnalyst"
        data-key="{{item.key}}"
      >
        <image class="chip-icon" src="../../images/providers/provider_{{item.key}}{{analystSelected[item.key] ? '_active' : ''}}.png" mode="aspectFit"></image>
        <text class="chip-name">{{item.name}}</text>
        <text class="chip-check" wx:if="{{analystSelected[item.key]}}">✓</text>
      </view>
    </scroll-view>
    <view class="provider-status unconfigured" wx:else>
      ⚠️ 未配置，请先在 我的 > AI 模型设置 中配置 API Key
    </view>
    <view class="provider-status configured" wx:if="{{configuredProviders.length > 0}}">
      已选 {{analysts.length}} 个分析模型
    </view>

    <!-- 汇总模型：仅当选择 >1 个分析师时显示 -->
    <view class="synth-row" wx:if="{{analysts.length > 1}}">
      <text class="synth-label">汇总模型</text>
      <picker bindchange="onSynthChange" value="{{synthIndex}}" range="{{synthNames}}">
        <view class="picker-row">
          <text class="picker-label">{{synthNames[synthIndex] || '请选择'}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 持仓概况 -->
  <view class="card">
    <view class="section-title">当前持仓概况</view>
    <view class="overview-grid">
      <view class="overview-item">
        <text class="overview-label">总资产</text>
        <text class="overview-value">¥{{fmt.formatMoney(summary.totalAssets)}}</text>
      </view>
      <view class="overview-item">
        <text class="overview-label">持仓产品</text>
        <text class="overview-value">{{summary.holdingCount || 0}} 只</text>
      </view>
      <view class="overview-item">
        <text class="overview-label">账户数量</text>
        <text class="overview-value">{{summary.accountCount || 0}} 个</text>
      </view>
      <view class="overview-item">
        <text class="overview-label">累计盈亏</text>
        <text class="overview-value {{pnlColor}}">{{fmt.pnlSign(summary.totalAllPnL != null ? summary.totalAllPnL : summary.totalPnL)}}{{fmt.formatMoney(summary.totalAllPnL != null ? summary.totalAllPnL : summary.totalPnL)}}</text>
      </view>
    </view>
  </view>

  <!-- 分析类型 -->
  <view class="card">
    <view class="section-title">分析类型</view>
    <view class="analysis-types">
      <view
        class="analysis-type-item {{selectedType === item.key ? 'selected' : ''}}"
        wx:for="{{analysisTypes}}"
        wx:key="key"
        bindtap="onTypeSelect"
        data-key="{{item.key}}"
      >
        <text class="type-icon">{{item.icon}}</text>
        <text class="type-name">{{item.name}}</text>
        <text class="type-desc">{{item.description}}</text>
      </view>
    </view>
  </view>

  <!-- 开始分析按钮 -->
  <view class="card">
    <button class="btn-primary" bindtap="onStartAnalysis" disabled="{{!canAnalyze}}">
      {{analyzing ? '分析中...' : '开始分析'}}
    </button>
    <text class="btn-hint" wx:if="{{!providerConfigured}}">请先配置 API Key</text>
    <text class="btn-hint" wx:elif="{{!summary.holdings || summary.holdings.length === 0}}">请先录入持仓数据</text>
  </view>

  <!-- 分析超时提示 -->
  <view class="card" wx:if="{{hasPendingReport}}">
    <view class="pending-hint">
      <text class="pending-icon">⏳</text>
      <text class="pending-text">{{pendingHint}}</text>
    </view>
  </view>

  <!-- 分析结果 -->
  <view class="card" wx:if="{{result.show}}">
    <view class="result-header">
      <text class="result-title">{{result.multiMode ? '综合分析报告' : '分析报告'}}</text>
      <text class="result-date">{{result.date}}</text>
    </view>
    <view class="result-risk" wx:if="{{result.riskLevel}}">
      <text>风险等级: </text>
      <text class="risk-badge">{{result.riskLevel}}</text>
    </view>
    <view class="result-summary">{{result.summary}}</view>
    <view class="result-findings" wx:if="{{result.findingBlocks && result.findingBlocks.length > 0}}">
      <view class="findings-title">关键发现</view>
      <view wx:for="{{result.findingBlocks}}" wx:for-item="fb" wx:for-index="fIdx" wx:key="fIdx" class="finding-item">
        <text class="finding-bullet">•</text>
        <view class="finding-body">
          <block wx:for="{{fb}}" wx:for-item="blk" wx:key="blkIndex" wx:for-index="blkIndex">
            <view wx:if="{{blk.type === 'paragraph'}}" class="md-para">
              <text wx:for="{{blk.inlines}}" wx:for-item="in" wx:key="inIdx" wx:for-index="inIdx"
                class="md-inline {{in.bold ? 'md-bold' : ''}} {{in.italic ? 'md-italic' : ''}} {{in.code ? 'md-code-inline' : ''}} {{in.color === 'primary' ? 'md-section-tag' : ''}}">{{in.text}}</text>
            </view>
            <view wx:elif="{{blk.type === 'list'}}" class="md-list">
              <view wx:for="{{blk.items}}" wx:for-item="it" wx:key="itIdx" wx:for-index="itIdx" class="md-list-item">
                <text class="md-list-marker">{{blk.ordered ? (itIdx + 1 + '.') : '·'}}</text>
                <view class="md-list-text">
                  <text wx:for="{{it}}" wx:for-item="in" wx:key="inIdx2" wx:for-index="inIdx2"
                    class="md-inline {{in.bold ? 'md-bold' : ''}} {{in.italic ? 'md-italic' : ''}} {{in.code ? 'md-code-inline' : ''}}">{{in.text}}</text>
                </view>
              </view>
            </view>
            <view wx:else class="md-para">
              <text wx:for="{{blk.inlines}}" wx:for-item="in" wx:key="inIdx3" wx:for-index="inIdx3"
                class="md-inline {{in.bold ? 'md-bold' : ''}} {{in.italic ? 'md-italic' : ''}} {{in.code ? 'md-code-inline' : ''}}">{{in.text}}</text>
            </view>
          </block>
        </view>
      </view>
    </view>
    <view class="result-content" wx:if="{{result.contentBlocks && result.contentBlocks.length > 0}}">
      <block wx:for="{{result.contentBlocks}}" wx:for-item="blk" wx:key="blkIdx" wx:for-index="blkIdx">
        <view wx:if="{{blk.type === 'heading'}}" class="md-heading md-h{{blk.level}}">
          <text wx:for="{{blk.inlines}}" wx:for-item="in" wx:key="inIdx" wx:for-index="inIdx"
            class="md-inline {{in.bold ? 'md-bold' : ''}} {{in.italic ? 'md-italic' : ''}} {{in.code ? 'md-code-inline' : ''}} {{in.color === 'primary' ? 'md-section-tag' : ''}}">{{in.text}}</text>
        </view>
        <view wx:elif="{{blk.type === 'paragraph'}}" class="md-para">
          <text wx:for="{{blk.inlines}}" wx:for-item="in" wx:key="inIdx2" wx:for-index="inIdx2"
            class="md-inline {{in.bold ? 'md-bold' : ''}} {{in.italic ? 'md-italic' : ''}} {{in.code ? 'md-code-inline' : ''}} {{in.color === 'primary' ? 'md-section-tag' : ''}}">{{in.text}}</text>
        </view>
        <view wx:elif="{{blk.type === 'list'}}" class="md-list">
          <view wx:for="{{blk.items}}" wx:for-item="it" wx:key="itIdx" wx:for-index="itIdx" class="md-list-item">
            <text class="md-list-marker">{{blk.ordered ? (itIdx + 1 + '.') : '·'}}</text>
            <view class="md-list-text">
              <text wx:for="{{it}}" wx:for-item="in" wx:key="inIdx3" wx:for-index="inIdx3"
                class="md-inline {{in.bold ? 'md-bold' : ''}} {{in.italic ? 'md-italic' : ''}} {{in.code ? 'md-code-inline' : ''}}">{{in.text}}</text>
            </view>
          </view>
        </view>
        <view wx:elif="{{blk.type === 'table'}}" class="md-table-wrap">
          <view class="md-table">
            <view class="md-table-row md-table-head">
              <view wx:for="{{blk.headers}}" wx:for-item="h" wx:key="hIdx" wx:for-index="hIdx" class="md-table-cell md-align-{{blk.aligns[hIdx] || 'left'}}">
                <text wx:for="{{h}}" wx:for-item="in" wx:key="inIdx4" wx:for-index="inIdx4"
                  class="md-inline md-bold">{{in.text}}</text>
              </view>
            </view>
            <view wx:for="{{blk.rows}}" wx:for-item="row" wx:key="rIdx" wx:for-index="rIdx" class="md-table-row">
              <view wx:for="{{row}}" wx:for-item="cell" wx:key="cIdx" wx:for-index="cIdx" class="md-table-cell md-align-{{blk.aligns[cIdx] || 'left'}}">
                <text wx:for="{{cell}}" wx:for-item="in" wx:key="inIdx5" wx:for-index="inIdx5"
                  class="md-inline {{in.bold ? 'md-bold' : ''}} {{in.code ? 'md-code-inline' : ''}}">{{in.text}}</text>
              </view>
            </view>
          </view>
        </view>
        <view wx:elif="{{blk.type === 'blockquote'}}" class="md-quote">
          <text wx:for="{{blk.inlines}}" wx:for-item="in" wx:key="inIdx6" wx:for-index="inIdx6"
            class="md-inline {{in.bold ? 'md-bold' : ''}} {{in.italic ? 'md-italic' : ''}}">{{in.text}}</text>
        </view>
        <text wx:elif="{{blk.type === 'code'}}" class="md-code-block" user-select="{{true}}">{{blk.text}}</text>
        <view wx:elif="{{blk.type === 'hr'}}" class="md-hr"></view>
      </block>
    </view>

    <!-- 多模型协作：各分析师独立报告（可折叠） -->
    <view class="sub-reports" wx:if="{{result.subReports && result.subReports.length > 0}}">
      <view class="sub-reports-title" bindtap="onToggleSubReports">
        <text>各分析师独立报告（{{result.subReports.length}} 份）</text>
        <text class="sub-toggle">{{showSubReports ? '收起 ▲' : '展开 ▼'}}</text>
      </view>
      <view wx:if="{{showSubReports}}">
        <view class="sub-report-item" wx:for="{{result.subReports}}" wx:for-item="sub" wx:key="provider" wx:for-index="subIdx">
          <view class="sub-report-header">
            <image class="chip-icon" src="../../images/providers/provider_{{sub.provider}}.png" mode="aspectFit"></image>
            <text class="sub-report-provider">{{sub.provider}}</text>
            <text class="sub-report-error" wx:if="{{sub.error}}">（失败：{{sub.error}}）</text>
          </view>
          <block wx:if="{{result.subContentBlocks[subIdx] && result.subContentBlocks[subIdx].length > 0}}">
            <block wx:for="{{result.subContentBlocks[subIdx]}}" wx:for-item="blk" wx:key="sblkIdx" wx:for-index="sblkIdx">
              <view wx:if="{{blk.type === 'heading'}}" class="md-heading md-h{{blk.level}}">
                <text wx:for="{{blk.inlines}}" wx:for-item="in" wx:key="inIdx4" wx:for-index="inIdx4"
                  class="md-inline {{in.bold ? 'md-bold' : ''}} {{in.color === 'primary' ? 'md-section-tag' : ''}}">{{in.text}}</text>
              </view>
              <view wx:elif="{{blk.type === 'paragraph'}}" class="md-para">
                <text wx:for="{{blk.inlines}}" wx:for-item="in" wx:key="inIdx5" wx:for-index="inIdx5"
                  class="md-inline {{in.bold ? 'md-bold' : ''}} {{in.code ? 'md-code-inline' : ''}}">{{in.text}}</text>
              </view>
              <view wx:elif="{{blk.type === 'list'}}" class="md-list">
                <view wx:for="{{blk.items}}" wx:for-item="it" wx:key="itIdx2" wx:for-index="itIdx2" class="md-list-item">
                  <text class="md-list-marker">{{blk.ordered ? (itIdx2 + 1 + '.') : '·'}}</text>
                  <view class="md-list-text">
                    <text wx:for="{{it}}" wx:for-item="in" wx:key="inIdx6" wx:for-index="inIdx6"
                      class="md-inline {{in.bold ? 'md-bold' : ''}} {{in.code ? 'md-code-inline' : ''}}">{{in.text}}</text>
                  </view>
                </view>
              </view>
              <view wx:elif="{{blk.type === 'table'}}" class="md-table-wrap">
                <view class="md-table">
                  <view class="md-table-row md-table-head">
                    <view wx:for="{{blk.headers}}" wx:for-item="h" wx:key="hIdx2" wx:for-index="hIdx2" class="md-table-cell md-align-{{blk.aligns[hIdx2] || 'left'}}">
                      <text wx:for="{{h}}" wx:for-item="in" wx:key="inIdx7" wx:for-index="inIdx7"
                        class="md-inline md-bold">{{in.text}}</text>
                    </view>
                  </view>
                  <view wx:for="{{blk.rows}}" wx:for-item="row" wx:key="rIdx2" wx:for-index="rIdx2" class="md-table-row">
                    <view wx:for="{{row}}" wx:for-item="cell" wx:key="cIdx2" wx:for-index="cIdx2" class="md-table-cell md-align-{{blk.aligns[cIdx2] || 'left'}}">
                      <text wx:for="{{cell}}" wx:for-item="in" wx:key="inIdx8" wx:for-index="inIdx8"
                        class="md-inline {{in.bold ? 'md-bold' : ''}}">{{in.text}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </block>
          </block>
          <text wx:else class="sub-report-content" user-select="{{true}}" decode="{{true}}">{{sub.content}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 历史报告 -->
  <view class="card" wx:if="{{historyReports && historyReports.length > 0}}">
    <view class="section-title">历史分析记录</view>
    <view
      wx:for="{{historyReports}}"
      wx:key="_id"
      class="history-item"
      bindtap="onViewHistory"
      data-report="{{item}}"
    >
      <view class="history-left">
        <text class="history-type">{{c.analysisTypeName(item.type)}}</text>
        <text class="history-model">{{item.provider || 'unknown'}}</text>
      </view>
      <view class="history-right">
        <text class="history-date">{{fmt.formatDate(item.created_at)}}</text>
        <text class="history-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 智能问答 -->
  <view class="card qa-section">
    <view class="section-title">💬 智能问答</view>
    <text class="qa-desc">用自然语言问关于您持仓的任何问题</text>
    <view class="qa-input-area">
      <input class="qa-input" placeholder="例如：我哪个产品亏最多？" model:value="{{qaQuestion}}" bindinput="onQaInputChange" />
      <button class="qa-send" bindtap="onAskQuestion" disabled="{{!canAsk}}">发送</button>
    </view>
    <view class="quick-questions" wx:if="{{!qaAnswer}}">
      <view class="quick-q" bindtap="onQuickQuestion" data-q="我的持仓是否过于集中？">› 我的持仓是否过于集中？</view>
      <view class="quick-q" bindtap="onQuickQuestion" data-q="哪个产品拖累收益最多？">› 哪个产品拖累收益最多？</view>
      <view class="quick-q" bindtap="onQuickQuestion" data-q="当前仓位适合什么行情？">› 当前仓位适合什么行情？</view>
      <view class="quick-q" bindtap="onQuickQuestion" data-q="我是不是银行股太多了？">› 我是不是银行股太多了？</view>
    </view>
    <view class="qa-answer" wx:if="{{qaAnswer}}">
      <view class="qa-bubble">{{qaAnswer}}</view>
    </view>
  </view>

  <view class="loading-container" wx:if="{{loading}}">
    <loading />
  </view>
</view>
