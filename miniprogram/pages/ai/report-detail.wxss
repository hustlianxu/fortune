/* 报告详情 */
.page { padding-bottom: 40rpx; }
.page-title { font-size: 40rpx; font-weight: 700; }

.report-meta { margin-top: 16rpx; }
.report-meta text {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 4rpx;
}

.risk-badge-row { margin-bottom: 20rpx; }

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin: 24rpx 0 12rpx;
}

.report-summary {
  font-size: 28rpx;
  line-height: 1.7;
  padding: 16rpx;
  background: var(--primary-soft);
  border-radius: var(--radius-sm);
}

.finding-row {
  padding: 8rpx 0;
  font-size: 26rpx;
  line-height: 1.5;
}

.report-content {
  font-size: 26rpx;
  line-height: 1.8;
}

.risk-badge-conservative { color: var(--color-down); font-weight: 600; }
.risk-badge-steady { color: var(--primary-color); font-weight: 600; }
.risk-badge-aggressive { color: var(--color-up); font-weight: 600; }
.risk-badge-radical { color: var(--color-up); font-weight: 600; }
.risk-badge-low { color: var(--color-down); font-weight: 600; }
.risk-badge-medium { color: var(--primary-color); font-weight: 600; }
.risk-badge-high { color: var(--color-up); font-weight: 600; }
