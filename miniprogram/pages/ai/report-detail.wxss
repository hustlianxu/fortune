/* 报告详情 - 全部颜色走 CSS 变量，暗黑模式自动适配 */
.page { padding-bottom: 40rpx; }
.page-title { font-size: 40rpx; font-weight: 700; color: var(--text-primary); }

.report-meta { margin-top: 16rpx; }
.report-meta text {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 4rpx;
}

.report-toolbar {
  display: flex;
  justify-content: flex-end;
  margin: 16rpx 0 0;
}
.btn-download {
  padding: 8rpx 20rpx;
  background: var(--bg-input);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--primary-color);
  border: 2rpx solid var(--border-color);
}
.btn-download:active { opacity: 0.6; }

.meta-label { color: var(--text-secondary); font-size: 26rpx; }
.risk-badge-row { margin-bottom: 20rpx; display: flex; align-items: center; gap: 8rpx; }

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin: 24rpx 0 12rpx;
}

.report-summary {
  font-size: 28rpx;
  line-height: 1.7;
  padding: 16rpx;
  color: var(--text-primary);
  background: var(--primary-soft);
  border-radius: var(--radius-sm);
}

.finding-row {
  padding: 8rpx 0;
  font-size: 26rpx;
  line-height: 1.5;
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}
.finding-bullet { color: var(--primary-color); font-weight: 700; flex-shrink: 0; }
.finding-body { flex: 1; min-width: 0; }

.report-content {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--text-primary);
}

/* ═══════ Markdown 渲染块 ═══════ */
.md-para {
  margin: 8rpx 0;
  color: var(--text-primary);
  word-break: break-all;
}
.md-heading {
  font-weight: 700;
  color: var(--text-primary);
  margin: 16rpx 0 8rpx;
  line-height: 1.4;
}
.md-h1 { font-size: 34rpx; }
.md-h2 { font-size: 32rpx; }
.md-h3 { font-size: 30rpx; }
.md-h4, .md-h5, .md-h6 { font-size: 28rpx; }

.md-list { margin: 8rpx 0; padding-left: 4rpx; }
.md-list-item {
  display: flex;
  align-items: flex-start;
  margin: 4rpx 0;
  color: var(--text-primary);
}
.md-list-marker {
  color: var(--primary-color);
  font-weight: 600;
  margin-right: 10rpx;
  flex-shrink: 0;
  min-width: 32rpx;
}
.md-list-text { flex: 1; min-width: 0; word-break: break-all; }

/* 表格 */
.md-table-wrap {
  margin: 16rpx 0;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--bg-card);
}
.md-table { width: 100%; }
.md-table-row {
  display: flex;
  border-bottom: 1rpx solid var(--divider-color);
}
.md-table-row:last-child { border-bottom: none; }
.md-table-head {
  background: var(--primary-soft);
}
.md-table-cell {
  flex: 1;
  padding: 12rpx 14rpx;
  font-size: 24rpx;
  color: var(--text-primary);
  word-break: break-all;
  border-right: 1rpx solid var(--divider-color);
}
.md-table-cell:last-child { border-right: none; }
.md-align-left { text-align: left; }
.md-align-center { text-align: center; }
.md-align-right { text-align: right; }

/* 引用 */
.md-quote {
  margin: 12rpx 0;
  padding: 12rpx 16rpx;
  background: var(--bg-input);
  border-left: 6rpx solid var(--primary-color);
  color: var(--text-secondary);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  font-size: 26rpx;
}

/* 代码块 */
.md-code-block {
  display: block;
  margin: 12rpx 0;
  padding: 16rpx;
  background: var(--bg-input);
  color: var(--text-primary);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  font-family: monospace;
  white-space: pre-wrap;
  word-break: break-all;
}
.md-code {
  display: block;
  margin: 8rpx 0;
  padding: 12rpx;
  background: var(--bg-input);
  color: var(--text-primary);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  font-family: monospace;
}

/* 分割线 */
.md-hr {
  height: 1rpx;
  background: var(--divider-color);
  margin: 20rpx 0;
}

/* 行内样式 */
.md-inline { color: inherit; }
.md-bold { font-weight: 700; color: var(--text-primary); }
.md-italic { font-style: italic; }
.md-code-inline {
  background: var(--bg-input);
  color: var(--color-up);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-family: monospace;
  font-size: 24rpx;
}
.md-section-tag {
  color: var(--primary-color);
  font-weight: 700;
}

/* 风险等级徽章 */
.risk-badge-conservative { color: var(--color-down); font-weight: 600; }
.risk-badge-steady { color: var(--primary-color); font-weight: 600; }
.risk-badge-aggressive { color: var(--color-up); font-weight: 600; }
.risk-badge-radical { color: var(--color-up); font-weight: 600; }
.risk-badge-low { color: var(--color-down); font-weight: 600; }
.risk-badge-medium { color: var(--primary-color); font-weight: 600; }
.risk-badge-high { color: var(--color-up); font-weight: 600; }

.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: var(--text-tertiary);
  font-size: 26rpx;
}
