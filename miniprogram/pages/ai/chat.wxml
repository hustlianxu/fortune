<!-- AI 智能问答 -->
<view class="page">
  <view class="chat-container">
    <view wx:for="{{messages}}" wx:key="id" class="chat-message {{item.role}}">
      <view class="bubble {{item.role}}">
        <text>{{item.content}}</text>
      </view>
    </view>
    <view class="empty-chat" wx:if="{{messages.length === 0}}">
      <text class="empty-icon">💬</text>
      <text>开始向 AI 提问关于您的持仓</text>
    </view>
  </view>

  <view class="chat-input-area">
    <input class="chat-input" placeholder="输入问题..." model:value="{{question}}" bindinput="onInputChange" />
    <button class="send-btn" bindtap="onSend" disabled="{{!canSend}}">发送</button>
  </view>
</view>
