<!-- AI 分析报告详情 -->
<wxs src="../../utils/format.wxs" module="fmt" />
<wxs src="../../utils/constants.wxs" module="c" />
<view class="page">
  <view class="card">
    <text class="page-title">📊 分析报告</text>
    <view class="report-meta" wx:if="{{report._id}}">
      <text>分析时间: {{fmt.formatDate(report.created_at)}}</text>
      <text>使用模型: {{report.provider || 'unknown'}} / {{report.model || ''}}</text>
      <text>数据类型: {{c.analysisTypeName(report.type)}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{report._id}}">
    <view class="risk-badge-row" wx:if="{{report.risk_level}}">
      <text>风险等级: </text>
      <text class="risk-badge-{{report.riskClass}}">{{report.risk_level}}</text>
    </view>

    <view class="section-title" wx:if="{{report.summary}}">摘要</view>
    <view class="report-summary">{{report.summary}}</view>

    <view wx:if="{{report.key_findings && report.key_findings.length > 0}}">
      <view class="section-title">关键发现</view>
      <view wx:for="{{report.key_findings}}" wx:for-item="finding" wx:key="*this" class="finding-row">
        <text>• {{finding}}</text>
      </view>
    </view>

    <view class="section-title">详细分析</view>
    <view class="report-content">
      <text class="report-text" user-select="{{true}}" decode="{{true}}">{{report.report_content}}</text>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text>报告未找到</text>
  </view>
</view>
