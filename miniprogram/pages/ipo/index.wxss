/* 打新战绩页 */
.page { padding-bottom: 40rpx; }
.page-title { font-size: 36rpx; font-weight: 600; color: var(--text-primary); margin-bottom: 20rpx; }
.section-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }

.summary-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.summary-item {
  flex: 1 1 30%;
  min-width: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  background: var(--bg-secondary, #f7f7fa);
  border-radius: 12rpx;
}
.summary-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-bottom: 8rpx;
}
.summary-value {
  font-size: 30rpx;
  font-weight: 600;
}

/* 年度统计表 */
.year-row {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--divider-color);
  align-items: center;
}
.year-row:last-child { border-bottom: none; }
.year-header {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 600;
}
.year-cell {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
}
.year-year { text-align: left; font-weight: 600; }

/* 明细列表 */
.ipo-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--divider-color);
}
.ipo-item:last-child { border-bottom: none; }
.ipo-item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.ipo-item-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.ipo-item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.cleared-tag {
  font-size: 20rpx;
  color: #999;
  border: 1rpx solid #ccc;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.ipo-item-pnl {
  font-size: 30rpx;
  font-weight: 600;
}
.ipo-item-mid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}
.ipo-item-bottom {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}
.ipo-item-date {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  color: var(--text-tertiary);
  gap: 12rpx;
}
.empty-icon { font-size: 64rpx; }
.empty-hint { font-size: 24rpx; }

.loading-state {
  text-align: center;
  padding: 60rpx;
  color: var(--text-tertiary);
}
