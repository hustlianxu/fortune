/* 语音/文字录入交易页面 */
.page {
  padding: 24rpx;
  background: var(--bg-primary);
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: var(--bg-card);
  border-radius: var(--radius-card, 16rpx);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.page-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 表单 */
.form-group {
  margin-bottom: 16rpx;
}
.form-group:last-child {
  margin-bottom: 0;
}
.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}
.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--bg-input, #f7f7f7);
  border-radius: var(--radius-sm, 10rpx);
  font-size: 28rpx;
  color: var(--text-primary);
}
.picker-arrow {
  color: var(--text-secondary);
  font-size: 24rpx;
}

/* Tab */
.tab-card {
  padding: 0 0 24rpx 0;
}
.tab-bar {
  display: flex;
  border-bottom: 1rpx solid var(--border-color, #eee);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
}
.tab.active {
  color: var(--primary-color);
  font-weight: 600;
  position: relative;
}
.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--primary-color);
  border-radius: 2rpx;
}
.tab-content {
  padding: 24rpx 28rpx 0 28rpx;
}
.tab-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.textarea-field {
  width: 100%;
  min-height: 240rpx;
  padding: 20rpx 24rpx;
  background: var(--bg-input, #f7f7f7);
  border-radius: var(--radius-sm, 10rpx);
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  box-sizing: border-box;
}
.json-area {
  font-family: monospace;
  min-height: 320rpx;
  font-size: 26rpx;
}
.hint-row {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  margin-top: 12rpx;
}
.link-btn {
  font-size: 26rpx;
  color: var(--primary-color);
  padding: 8rpx 16rpx;
}
.link-btn.danger {
  color: #e74c3c;
}

/* 主按钮 */
.btn-primary {
  margin-top: 24rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: var(--radius-sm, 10rpx);
  font-size: 30rpx;
  padding: 24rpx 0;
}
.btn-primary[disabled] {
  opacity: 0.5;
}

/* 解析结果 */
.section-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.warnings {
  background: #fff7e6;
  border-left: 6rpx solid #faad14;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 6rpx;
}
.warning-title {
  display: block;
  font-size: 26rpx;
  color: #d46b08;
  margin-bottom: 8rpx;
}
.warning-item {
  display: block;
  font-size: 24rpx;
  color: #874d00;
  line-height: 1.6;
}

.trade-item {
  position: relative;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color, #f0f0f0);
}
.trade-item:last-child {
  border-bottom: none;
}
.trade-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.trade-type {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  color: #fff;
  background: var(--text-secondary);
}
.tag-buy { background: var(--txn-buy, #e74c3c); }
.tag-sell { background: var(--txn-sell, #27ae60); }
.tag-dividend { background: var(--txn-income, #f39c12); }
.tag-transfer_in { background: var(--txn-transfer, #3498db); }
.tag-transfer_out { background: var(--txn-transfer, #7f8c8d); }
.tag-fee { background: var(--text-secondary); }
.tag-interest { background: var(--txn-income, #f39c12); }

.trade-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}
.trade-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}
.trade-date {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.trade-detail {
  display: flex;
  gap: 16rpx;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.trade-amount {
  color: var(--text-primary);
  font-weight: 600;
}
.trade-fee {
  font-size: 22rpx;
  color: var(--text-tertiary);
}
.trade-actions {
  position: absolute;
  top: 20rpx;
  right: 0;
  display: flex;
  align-items: center;
}
.trade-edit {
  font-size: 28rpx;
  color: var(--primary-color);
  padding: 8rpx 12rpx;
}
.trade-remove {
  font-size: 28rpx;
  color: var(--text-tertiary);
  padding: 8rpx 16rpx;
}

/* 编辑弹层 */
.edit-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}
.edit-panel {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: var(--bg-card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  z-index: 1001;
  max-height: 80vh;
  overflow-y: auto;
}
.edit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.edit-title { font-size: 32rpx; font-weight: 600; color: var(--text-primary); }
.edit-close { font-size: 36rpx; color: var(--text-tertiary); padding: 4rpx 16rpx; }
.edit-body { padding-bottom: 16rpx; }
.edit-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--divider-color);
}
.edit-label { width: 140rpx; font-size: 26rpx; color: var(--text-secondary); flex-shrink: 0; }
.edit-input {
  flex: 1; height: 72rpx; padding: 0 16rpx;
  background: var(--bg-input); border-radius: 8rpx;
  font-size: 28rpx; color: var(--text-primary);
}
.edit-picker {
  display: flex; justify-content: space-between; align-items: center;
  flex: 1; height: 72rpx; padding: 0 16rpx;
  background: var(--bg-input); border-radius: 8rpx;
  font-size: 28rpx;
}
.edit-footer {
  display: flex; gap: 16rpx; margin-top: 24rpx;
}
.edit-footer .btn-primary, .edit-footer .btn-secondary { flex: 1; margin: 0; }
.btn-secondary {
  height: 80rpx; line-height: 80rpx; text-align: center;
  border-radius: 12rpx; font-size: 28rpx; color: var(--text-secondary);
  background: var(--bg-input);
}

.confirm-btn {
  margin-top: 20rpx;
}

/* 提示 */
.tip-card {
  background: var(--bg-input);
}
.tip-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}
.tip-line {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}
.tip-line.link {
  color: var(--primary-color);
  margin-top: 8rpx;
}
