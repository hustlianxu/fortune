<!-- 语音/文字录入交易 -->
<view class="page">
  <view class="card">
    <text class="page-title">🎙️ 语音/文字录入</text>
    <text class="page-desc">粘贴语音转文字内容或自然语言交易描述，AI 自动解析为结构化交易</text>
  </view>

  <!-- 账户选择 -->
  <view class="card">
    <view class="form-group">
      <text class="form-label">目标账户 *</text>
      <picker bindchange="onAccountChange" value="{{accountIndex}}" range="{{accountNames}}">
        <view class="picker-row">
          <text>{{accountIndex >= 0 ? accountNames[accountIndex] : '请选择账户'}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- Tab 切换 -->
  <view class="card tab-card">
    <view class="tab-bar">
      <view class="tab {{activeTab === 'text' ? 'active' : ''}}" bindtap="onTabChange" data-tab="text">
        <text>📝 自然语言</text>
      </view>
      <view class="tab {{activeTab === 'json' ? 'active' : ''}}" bindtap="onTabChange" data-tab="json">
        <text>🔧 JSON 导入</text>
      </view>
    </view>

    <!-- 文字 Tab -->
    <view class="tab-content" wx:if="{{activeTab === 'text'}}">
      <textarea
        class="textarea-field"
        placeholder="例如：3月15号买入1000股招商银行，36块5，手续费5块；4月20号38块2卖出500股……"
        value="{{textInput}}"
        bindinput="onTextInput"
        auto-height
        maxlength="-1"
      />
      <view class="hint-row">
        <text class="link-btn" bindtap="onFillSample">填入示例</text>
        <text class="link-btn" bindtap="onClearInput" wx:if="{{textInput}}">清空</text>
      </view>
    </view>

    <!-- JSON Tab -->
    <view class="tab-content" wx:if="{{activeTab === 'json'}}">
      <text class="tab-desc">在外部 LLM（DeepSeek/ChatGPT 等）按 docs/06 提示词拿到 JSON 后，粘贴到这里导入</text>
      <textarea
        class="textarea-field json-area"
        placeholder='[{"type":"buy","product_name":"招商银行",...}]'
        value="{{jsonInput}}"
        bindinput="onJsonInput"
        auto-height
        maxlength="-1"
      />
      <view class="hint-row">
        <text class="link-btn" bindtap="onFillSample">填入示例</text>
        <text class="link-btn" bindtap="onClearInput" wx:if="{{jsonInput}}">清空</text>
      </view>
    </view>

    <button class="btn-primary" bindtap="onParse" loading="{{parsing}}" disabled="{{parsing}}">
      {{parsing ? 'AI 解析中...' : '🤖 AI 解析预览'}}
    </button>
  </view>

  <!-- 解析结果预览 -->
  <view class="card" wx:if="{{parsedTrades.length > 0}}">
    <view class="section-row">
      <text class="section-title">解析结果（{{parsedTrades.length}} 笔）</text>
      <text class="link-btn danger" bindtap="onConfirmImport" wx:if="{{!importing}}">✓ 确认导入</text>
    </view>

    <view class="warnings" wx:if="{{warnings.length > 0}}">
      <text class="warning-title">⚠ 提示：</text>
      <text class="warning-item" wx:for="{{warnings}}" wx:key="*this">· {{item}}</text>
    </view>

    <view class="trade-item" wx:for="{{parsedTrades}}" wx:key="index">
      <view class="trade-main">
        <text class="trade-type tag-{{item.type}}">{{item.typeLabel}}</text>
        <view class="trade-info">
          <text class="trade-name">{{item.product_name || item.product_code || '未命名'}}</text>
          <text class="trade-date">{{item.trade_date}}</text>
        </view>
      </view>
      <view class="trade-detail">
        <text wx:if="{{item.shares > 0}}">{{item.shares}} 股 × ¥{{item.price}}</text>
        <text class="trade-amount">¥{{item.amountText}}</text>
        <text class="trade-fee" wx:if="{{item.feeText}}">{{item.feeText}}</text>
      </view>
      <text class="trade-remove" bindtap="onRemoveTrade" data-index="{{index}}">✕</text>
    </view>

    <button class="btn-primary confirm-btn" bindtap="onConfirmImport" loading="{{importing}}" disabled="{{importing}}">
      {{importing ? '导入中...' : '✓ 确认导入 ' + parsedTrades.length + ' 笔'}}
    </button>
  </view>

  <!-- 提示 -->
  <view class="card tip-card">
    <text class="tip-title">💡 使用提示</text>
    <text class="tip-line">· 文字模式：直接粘贴语音转文字内容，每笔交易可换行或用顿号/分号分隔</text>
    <text class="tip-line">· JSON 模式：在外部 LLM 用 docs/06 提示词生成 JSON 后粘贴导入</text>
    <text class="tip-line">· 解析预览不会写入数据，确认无误后才正式导入</text>
    <text class="tip-line">· 导入后买卖交易会自动同步持仓（加权平均成本，含手续费）</text>
    <text class="tip-line link" bindtap="onGoToLLMSettings">· 未配置 LLM？点这里去配置 →</text>
  </view>
</view>
