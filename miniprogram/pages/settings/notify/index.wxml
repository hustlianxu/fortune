<!-- 推送设置 -->
<view class="page">
  <view class="card">
    <text class="page-title">🔔 推送设置</text>
  </view>

  <view class="card">
    <view class="setting-row">
      <view class="setting-info">
        <text class="setting-label">每日早报推送</text>
        <text class="setting-desc">早 8:00 推送当日要闻</text>
      </view>
      <switch checked="{{morningNews}}" bindchange="onToggleMorning" color="#6c63ff" />
    </view>
    <view class="setting-row">
      <view class="setting-info">
        <text class="setting-label">收盘晚报推送</text>
        <text class="setting-desc">下午 5:00 推送收盘速览</text>
      </view>
      <switch checked="{{eveningNews}}" bindchange="onToggleEvening" color="#6c63ff" />
    </view>
    <view class="setting-row">
      <view class="setting-info">
        <text class="setting-label">涨跌提醒</text>
        <text class="setting-desc">持仓产品涨跌幅超过阈值时通知</text>
      </view>
      <switch checked="{{priceAlert}}" bindchange="onToggleAlert" color="#6c63ff" />
    </view>
  </view>

  <view class="card" wx:if="{{priceAlert}}">
    <view class="form-group">
      <text class="form-label">涨跌幅阈值 (%)</text>
      <input class="input-field" type="digit" placeholder="3" model:value="{{alertThreshold}}" />
    </view>
  </view>

  <!-- ═══════ 订阅消息模板 ID 录入 ═══════ -->
  <view class="card">
    <view class="section-title">订阅消息模板 ID</view>
    <view class="section-desc">
      请先在微信公众平台「订阅消息」后台申请模板，将申请到的模板 ID 填入对应项；
      未填写的项即使开关已开启，也不会推送。
    </view>

    <view class="form-group">
      <text class="form-label">早报模板 ID</text>
      <input
        class="input-field"
        placeholder="如 XX_XX_XX_XX"
        value="{{tmplIds.morning}}"
        bindinput="onMorningTmplInput"
      />
    </view>
    <view class="form-group">
      <text class="form-label">晚报模板 ID</text>
      <input
        class="input-field"
        placeholder="如 XX_XX_XX_XX"
        value="{{tmplIds.evening}}"
        bindinput="onEveningTmplInput"
      />
    </view>
    <view class="form-group">
      <text class="form-label">涨跌提醒模板 ID</text>
      <input
        class="input-field"
        placeholder="如 XX_XX_XX_XX"
        value="{{tmplIds.price_alert}}"
        bindinput="onPriceAlertTmplInput"
      />
    </view>
  </view>

  <view class="card">
    <button class="btn-primary" bindtap="onSave">保存设置</button>
  </view>

  <view class="card notice">
    <text class="notice-text">提示：推送功能依赖微信订阅消息。保存后需在弹窗中点击「允许」以授权推送。已开启项未填模板 ID 时不会推送。</text>
  </view>
</view>
