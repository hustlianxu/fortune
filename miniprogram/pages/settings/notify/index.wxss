/* 推送设置 */
.page { padding-bottom: 40rpx; }
.page-title { font-size: 40rpx; font-weight: 700; }

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--divider-color);
}
.setting-info { flex: 1; }
.setting-label { font-size: 28rpx; font-weight: 500; display: block; }
.setting-desc { font-size: 22rpx; color: var(--text-tertiary); margin-top: 4rpx; display: block; }

.form-group { margin-top: 20rpx; }
.form-label { font-size: 24rpx; color: var(--text-tertiary); display: block; margin-bottom: 8rpx; }
.input-field {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--border-color);
  font-size: 28rpx;
  box-sizing: border-box;
  color: var(--text-primary);
}

.btn-primary {
  background: var(--primary-color);
  color: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  width: 100%;
  text-align: center;
}

.notice { background: var(--primary-soft); }
.notice-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}
