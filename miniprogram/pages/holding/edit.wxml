<!-- 添加/编辑持仓 -->
<wxs src="../../utils/format.wxs" module="fmt" />
<wxs src="../../utils/constants.wxs" module="c" />
<view class="page">
  <view class="card">
    <text class="page-title">{{isEdit ? '编辑持仓' : '添加持仓'}}</text>
  </view>

  <view class="card">
    <view class="form-group">
      <text class="form-label">所属账户 *</text>
      <picker bindchange="onAccountChange" value="{{accountIndex}}" range="{{accountNames}}">
        <view class="picker-row">
          <text>{{accountNames[accountIndex] || '请选择账户'}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">产品代码 *</text>
      <input class="input-field" placeholder="如：600036" value="{{form.product_code}}" bindinput="onCodeInput" />
      <view class="lookup-hint" wx:if="{{codeLookupHint}}">{{codeLookupHint}}</view>
      <view class="suggestions" wx:if="{{codeSuggestions.length > 0}}">
        <view
          class="suggestion-item"
          wx:for="{{codeSuggestions}}"
          wx:key="code"
          bindtap="onCodeSuggestionClick"
          data-code="{{item.code}}"
          data-name="{{item.name}}"
          data-type="{{item.type}}"
          data-exchange="{{item.exchange}}"
        >
          <view class="suggestion-left">
            <text class="suggestion-name">{{item.name}}</text>
            <text class="suggestion-code">{{item.code}}</text>
          </view>
          <text class="suggestion-type tag-{{item.type}}">{{c.productTypeName(item.type)}}</text>
        </view>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">产品名称</text>
      <input class="input-field" placeholder="如：招商银行" value="{{form.product_name}}" bindinput="onNameInput" />
      <!-- 名称搜索建议 -->
      <view class="suggestions" wx:if="{{suggestions.length > 0}}">
        <view
          class="suggestion-item"
          wx:for="{{suggestions}}"
          wx:key="code"
          bindtap="onSelectSuggestion"
          data-code="{{item.code}}"
          data-name="{{item.name}}"
          data-type="{{item.type}}"
          data-exchange="{{item.exchange}}"
        >
          <view class="suggestion-left">
            <text class="suggestion-name">{{item.name}}</text>
            <text class="suggestion-code">{{item.code}}</text>
          </view>
          <text class="suggestion-type tag-{{item.type}}">{{c.productTypeName(item.type)}}</text>
        </view>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">产品类型</text>
      <picker bindchange="onTypeChange" value="{{typeIndex}}" range="{{typeNames}}">
        <view class="picker-row">
          <text>{{typeNames[typeIndex] || '请选择'}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">交易所</text>
      <picker bindchange="onExchangeChange" value="{{exchangeIndex}}" range="{{['上海','深圳','港股','美股']}}">
        <view class="picker-row">
          <text>{{['上海','深圳','港股','美股'][exchangeIndex]}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">持有份额 *</text>
      <input class="input-field" type="digit" placeholder="0" value="{{form.shares}}" bindinput="onSharesInput" />
    </view>

    <view class="form-group">
      <text class="form-label">成本单价 *</text>
      <input class="input-field" type="digit" placeholder="0.00" value="{{form.cost_price}}" bindinput="onCostPriceInput" />
    </view>

    <view class="form-group">
      <text class="form-label">买入日期</text>
      <picker mode="date" value="{{form.buy_date || today}}" bindchange="onDateChange">
        <view class="picker-row">
          <text>{{form.buy_date || '请选择日期'}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">备注</text>
      <input class="input-field" placeholder="可选" value="{{form.note}}" bindinput="onNoteInput" />
    </view>
  </view>

  <!-- 策略/跟投计划标签 -->
  <view class="card">
    <view class="card-title">跟投策略 & 行业</view>
    <text class="fee-desc">标记此持仓属于哪个跟投计划/行业，可在多维度分析中聚合查看</text>
    <view class="form-group">
      <text class="form-label">策略/计划名称</text>
      <input class="input-field" placeholder="如：长赢150份、S定投、螺丝钉定投…（留空不归类）" value="{{form.strategy}}" bindinput="onStrategyInput" />
    </view>
    <view class="form-group">
      <text class="form-label">行业分类</text>
      <input class="input-field" placeholder="如：银行、半导体、新能源、消费…（留空为未分类）" value="{{form.industry}}" bindinput="onIndustryInput" />
      <view class="switch-row">
        <text class="switch-label">参与「刷新行业」任务</text>
        <switch checked="{{form.industry_auto_refresh}}" bindchange="onAutoRefreshChange" color="#4a6cf7" />
      </view>
      <text class="form-hint">开启后，在持仓列表「刷新行业」时由 AI 自动推断行业（不覆盖手填值）；关闭后该持仓不参与自动推断。</text>
    </view>
  </view>

  <!-- 单基金费率覆盖（基金账户适用，优先级高于账户层级配置） -->
  <view class="card" wx:if="{{currentAccountType === 'fund_platform'}}">
    <view class="card-title">单基金费率覆盖</view>
    <text class="fee-desc">已填则优先使用本设置，留空则使用账户默认费率。管理费/托管费/投顾费为年化费率。</text>

    <view class="fee-row">
      <view class="fee-group">
        <text class="form-label">管理费（年化）</text>
        <input class="input-field fee-input" placeholder="如 0.012（1.2%）" type="digit" value="{{form.management_fee_rate}}" bindinput="onMgmtFeeInput" />
      </view>
      <view class="fee-group">
        <text class="form-label">托管费（年化）</text>
        <input class="input-field fee-input" placeholder="如 0.002（0.2%）" type="digit" value="{{form.custodian_fee_rate}}" bindinput="onCustodianFeeInput" />
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">投顾费（年化，可选）</text>
      <input class="input-field" placeholder="如 0.005（0.5%）" type="digit" value="{{form.advisory_fee_rate}}" bindinput="onAdvisoryFeeInput" />
    </view>
  </view>

  <view class="card">
    <button class="btn-primary" bindtap="onSave">保存</button>
  </view>
</view>
