<wxs src="../../utils/format.wxs" module="fmt" />
<wxs src="../../utils/constants.wxs" module="c" />
<!-- 持仓详情 -->
<view class="page">
  <view class="card" wx:if="{{holding._id}}">
    <view class="holding-header">
      <text class="holding-name">{{holding.product_name}}</text>
      <text class="holding-code">{{holding.product_code}}</text>
      <text class="tag {{c.tagClass(holding.product_type)}}">{{c.productTypeName(holding.product_type)}}</text>
      <text class="cleared-badge" wx:if="{{holding.is_cleared}}">已清仓</text>
    </view>

    <view class="price-row">
      <view class="price-item">
        <text class="price-label">现价</text>
        <text class="price-value {{priceColor}}">{{fmt.formatMoney(holding.current_price)}}</text>
      </view>
      <view class="price-item">
        <text class="price-label">成本</text>
        <text class="price-value">{{fmt.formatMoney(holding.cost_price)}}</text>
      </view>
      <view class="price-item">
        <text class="price-label">浮动盈亏</text>
        <text class="price-value {{fmt.pnlClass(holding.pnl)}}">
          {{fmt.pnlSign(holding.pnl)}}{{fmt.formatMoney(holding.pnl)}}
        </text>
      </view>
    </view>

    <!-- 总收益（同花顺口径） -->
    <view class="total-pnl-card {{fmt.pnlClass(holding.total_pnl)}}">
      <view class="total-pnl-row">
        <text class="total-pnl-label">总收益</text>
        <text class="total-pnl-value">{{fmt.pnlSign(holding.total_pnl)}}{{fmt.formatMoney(holding.total_pnl)}}</text>
      </view>
      <text class="total-pnl-pct">收益率 {{fmt.formatPercent(holding.total_pnl_percent)}}</text>
      <text class="total-pnl-hint">总收益 = 浮动 + 已实现 + 分红（手续费已计入成本与已实现）</text>
    </view>

    <!-- 收益分项明细 -->
    <view class="pnl-breakdown" wx:if="{{holding.realized_pnl || holding.total_dividend || holding.total_fee}}">
      <view class="breakdown-item">
        <text class="breakdown-label">浮动盈亏</text>
        <text class="breakdown-value {{fmt.pnlClass(holding.pnl)}}">{{fmt.pnlSign(holding.pnl)}}¥{{fmt.formatMoney(holding.pnl)}}</text>
      </view>
      <view class="breakdown-item" wx:if="{{holding.realized_pnl}}">
        <text class="breakdown-label">已实现盈亏</text>
        <text class="breakdown-value {{fmt.pnlClass(holding.realized_pnl)}}">{{fmt.pnlSign(holding.realized_pnl)}}¥{{fmt.formatMoney(holding.realized_pnl)}}</text>
      </view>
      <view class="breakdown-item" wx:if="{{holding.total_dividend}}">
        <text class="breakdown-label">累计分红</text>
        <text class="breakdown-value breakdown-income">+¥{{fmt.formatMoney(holding.total_dividend)}}</text>
      </view>
      <view class="breakdown-item" wx:if="{{holding.total_fee}}">
        <text class="breakdown-label">累计手续费</text>
        <text class="breakdown-value breakdown-fee">-¥{{fmt.formatMoney(holding.total_fee)}}</text>
      </view>
    </view>

    <view class="info-grid">
      <view class="info-item">
        <text class="info-label">持有份额</text>
        <text class="info-value">{{fmt.formatQuantity(holding.shares)}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">市值</text>
        <text class="info-value">¥{{fmt.formatMoney(holding.market_value)}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">成本金额</text>
        <text class="info-value">¥{{fmt.formatMoney(holding.cost_value)}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">浮动盈亏比例</text>
        <text class="info-value {{fmt.pnlClass(holding.pnl_percent)}}">
          {{fmt.formatPercent(holding.pnl_percent)}}
        </text>
      </view>
      <view class="info-item">
        <text class="info-label">买入日期</text>
        <text class="info-value">{{holding.buy_date || '--'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">更新日期</text>
        <text class="info-value">{{fmt.formatDate(holding.price_updated_at, 'MM-DD')}}</text>
      </view>
    </view>

    <view class="action-buttons">
      <button class="btn-trade" bindtap="onRecordTrade">记一笔买卖</button>
      <button class="btn-edit" bindtap="onEdit">编辑</button>
      <button class="btn-delete" bindtap="onDelete">删除</button>
    </view>
  </view>

  <!-- 累计成本趋势图 -->
  <view class="card" wx:if="{{transactions.length >= 2}}">
    <view class="section-title">累计投入趋势</view>
    <view class="chart-wrap">
      <canvas type="2d" id="costChart" class="cost-chart"></canvas>
    </view>
  </view>

  <!-- 交易列表 -->
  <view class="card" wx:if="{{transactions.length > 0}}">
    <view class="section-title">全部交易（{{transactions.length}}）</view>
    <view
      class="recent-txn"
      wx:for="{{transactions}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindlongpress="onLongPressTxn"
      bindtap="onEditTxn"
    >
      <view class="recent-txn-left">
        <view class="recent-txn-badge-row">
          <text class="recent-txn-badge {{c.transactionTypeClass(item.type)}}">{{c.transactionTypeName(item.type)}}</text>
          <text class="recent-txn-sync-indicator {{item.applied_holding ? 'synced' : 'pending'}}">
            {{item.applied_holding ? '✓' : '⏳'}}
          </text>
          <text class="txn-build-badge" wx:if="{{item.type === 'buy' && item.is_opening}}">建仓</text>
        </view>
        <text class="recent-txn-date">{{item.trade_date}}</text>
      </view>
      <view class="recent-txn-right">
        <text class="recent-txn-shares">{{fmt.formatQuantity(item.shares)}} @ {{fmt.formatMoney(item.price)}}</text>
        <text class="recent-txn-amount {{c.transactionTypeClass(item.type)}}">
          {{c.transactionSign(item.type)}}¥{{fmt.formatMoney(item.amount)}}
        </text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:elif="{{holding._id && !loadingTxns}}">
    <text>该持仓暂无交易记录</text>
    <text class="empty-hint">点击「记一笔买卖」开始记录</text>
  </view>

  <view class="empty-state" wx:if="{{!holding._id}}">
    <text>持仓记录未找到</text>
  </view>
</view>
