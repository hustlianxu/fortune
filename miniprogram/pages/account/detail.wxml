<wxs src="../../utils/format.wxs" module="fmt" />
<wxs src="../../utils/constants.wxs" module="c" />
<!-- 账户详情 -->
<view class="page">
  <view class="card" wx:if="{{account._id}}">
    <view class="account-header-section">
      <text class="account-name">{{account.name}}</text>
      <text class="account-platform">{{c.platformName(account.platform)}}</text>
    </view>

    <view class="account-total">
      <text class="total-label">总资产</text>
      <text class="total-value">¥{{fmt.formatMoney(account.total_value)}}</text>
      <text class="total-pnl {{fmt.pnlClass(account.pnl)}}">
        {{fmt.pnlSign(account.pnl)}}{{fmt.formatMoney(account.pnl)}}
      </text>
    </view>

    <view class="balance-row" wx:if="{{account.cash_balance}}">
      <text>余额: ¥{{fmt.formatMoney(account.cash_balance)}}</text>
    </view>

    <view class="section-title">持仓列表 ({{account.holdingCount}})</view>
    <view class="holding-item" wx:for="{{account.holdings}}" wx:for-item="h" wx:key="_id"
          bindtap="onHoldingTap" data-holding="{{h}}">
      <view class="holding-top">
        <text class="h-name">{{h.product_name}}</text>
        <text class="h-pnl {{fmt.pnlClass(h.pnl)}}">
          {{fmt.pnlSign(h.pnl)}}{{fmt.formatMoney(h.pnl)}}
        </text>
      </view>
      <view class="holding-bottom">
        <text>{{h.product_code}}</text>
        <text>现价: {{fmt.formatMoney(h.current_price)}}</text>
        <text>份额: {{fmt.formatQuantity(h.shares)}}</text>
        <text>市值: {{fmt.formatMoney(h.market_value)}}</text>
      </view>
    </view>

    <view class="action-bar">
      <button class="btn-edit" bindtap="onEditAccount">编辑账户</button>
      <button class="btn-add" bindtap="onAddHolding">+ 添加持仓</button>
    </view>
  </view>
</view>
