/* 账户详情 */
.page { padding-bottom: 40rpx; }

.account-header-section { text-align: center; margin-bottom: 20rpx; }
.account-name { font-size: 36rpx; font-weight: 700; display: block; }
.account-platform { font-size: 24rpx; color: var(--text-tertiary); display: block; margin-top: 4rpx; }

.account-total { text-align: center; margin-bottom: 16rpx; }
.total-label { font-size: 24rpx; color: var(--text-tertiary); display: block; }
.total-value { font-size: 48rpx; font-weight: 700; display: block; margin: 8rpx 0; }
.total-pnl { font-size: 28rpx; display: block; }

.balance-row {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--divider-color);
  margin-bottom: 20rpx;
}

.section-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }

.chart-wrap {
  width: 100%;
  height: 320rpx;
}
.cost-chart {
  width: 100%;
  height: 100%;
}

.strategy-group-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--divider-color);
  margin-top: 8rpx;
}
.sg-toggle { font-size: 20rpx; color: var(--text-tertiary); margin-right: 12rpx; }
.sg-name { flex: 1; font-size: 26rpx; font-weight: 600; color: var(--primary-color); }
.sg-pnl { font-size: 24rpx; font-weight: 500; margin-right: 12rpx; }
.sg-count { font-size: 22rpx; color: var(--text-tertiary); }

.holding-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--divider-color);
}
.holding-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.h-name { font-size: 28rpx; font-weight: 500; }
.h-pnl { font-size: 26rpx; font-weight: 500; }
.holding-bottom {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}
.holding-bottom text { font-size: 22rpx; color: var(--text-tertiary); }

.action-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.btn-edit {
  flex: 1;
  background: transparent;
  color: var(--primary-color);
  padding: 20rpx;
  border-radius: var(--radius-sm);
  text-align: center;
  border: 2rpx solid var(--primary-color);
  font-size: 28rpx;
}
.btn-add {
  flex: 1;
  background: var(--primary-color);
  color: #fff;
  padding: 20rpx;
  border-radius: var(--radius-sm);
  text-align: center;
  border: none;
  font-size: 28rpx;
}
