/* 账户编辑 */
.page { padding-bottom: 40rpx; }
.page-title { font-size: 40rpx; font-weight: 700; }

.form-group { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: var(--text-tertiary); display: block; margin-bottom: 8rpx; }

.input-field {
  width: 100%;
  padding: 24rpx 24rpx;
  background: var(--bg-input);
  height: auto;
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--border-color);
  font-size: 28rpx;
  box-sizing: border-box;
  color: var(--text-primary);
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--bg-input);
  height: auto;
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--border-color);
}
.picker-arrow { font-size: 24rpx; color: var(--text-tertiary); }

.btn-primary {
  background: var(--primary-color);
  color: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  width: 100%;
  text-align: center;
  margin-bottom: 20rpx;
}
.btn-delete {
  background: transparent;
  color: var(--color-up);
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  width: 100%;
  text-align: center;
  border: 2rpx solid var(--color-up);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: var(--text-primary);
}

.fee-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.fee-group {
  flex: 1;
  min-width: 0;
}

.fee-input {
  width: 100%;
}

/* ═══════ 佣金表格样式 ═══════ */
.fee-market-section {
  margin-bottom: 28rpx;
}
.fee-market-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-bottom: 12rpx;
  display: block;
}

.fee-table {
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  overflow: hidden;
}
.fee-tr {
  display: flex;
  border-bottom: 1rpx solid var(--border-color);
}
.fee-tr:last-child { border-bottom: none; }
.fee-th { background: var(--bg-input); font-weight: 600; }
.fee-td {
  flex: 1;
  padding: 14rpx 12rpx;
  font-size: 24rpx;
  color: var(--text-primary);
  text-align: center;
  box-sizing: border-box;
}
.fee-category {
  flex: 0 0 100rpx;
  font-weight: 500;
  color: var(--text-primary);
  text-align: left;
}
.fee-rate { flex: 1; }
.fee-min { flex: 1; }

.fee-input-cell {
  height: auto !important;
  min-height: auto !important;
  padding: 8rpx 12rpx !important;
  font-size: 24rpx !important;
  text-align: center !important;
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  color: var(--text-primary);
}

/* ═══════ 其他费用（简行） ═══════ */
.fee-simple-row {
  display: flex;
  gap: 20rpx;
}
.fee-simple-item {
  flex: 1;
}

.fee-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.fee-hint {
  font-size: 22rpx;
  color: var(--text-quaternary, #999);
  margin-top: 6rpx;
  display: block;
}

.fee-divider {
  height: 2rpx;
  background: var(--border-color);
  margin: 20rpx 0;
}

.card-subtitle {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 20rpx;
}
